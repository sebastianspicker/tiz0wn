# Evidence contains device identifiers (serial, MAC, DUID, tokens). Never commit.
evidence/*
!evidence/.gitkeep
!evidence/README.md

# Local device config holds your TV's IP and host IP.
config/tv.env

# Raw tool output / private probes
*.log
*-private.*
tv-info*.json

# Ledgers and tests are local-only: histories churn and the suites are large.
LEDGER.jsonl
LEDGER.head
LEDGER.lock
test_*.py
test_*.c
/exploits/*/tests/

/exploits/*/runs/
/exploits/*/dist/

# Local agent handoff, isolated builds, and diagnostic traces
.agents/

# OS / editor
.DS_Store
*.swp

# Local firmware bundle (image, third-party tools, raw outputs). Never commit.
/fw-analysis/

# Python bytecode cache
__pycache__/
*.pyc
.ruff_cache/

# Rewrite staging copies + process report (originals already replaced in place)
/rewritten/
