# Copy to tv.env and fill in YOUR values. tv.env is gitignored.
#
#   cp config/tv.env.example config/tv.env
#
# Then edit the addresses and, before any guarded live research, the pinned
# target identity fields below. Offline and loopback tests do not read tv.env.

# Absolute path to the sdb binary from an official Tizen Studio install.
# Default location from docs/setup-macos.md (bash <installer>.bin --accept-license ~/tizen-studio).
SDB="$HOME/tizen-studio/tools/sdb"

# The television's IP address on your LAN (from the TV menu or router client list).
TV_IP="192.168.1.50"          # <-- REPLACE with your TV's actual address.

# The TCP serial sdb uses for a network target is normally IP:26101.
TV_SERIAL="${TV_IP}:26101"

# The investigating computer's IP, entered on the TV in Developer Mode.
# This is NOT the TV's address. (For a TizenBrew install it may later become
# 127.0.0.1 — see research doc §8.2 before changing it.)
HOST_IP="192.168.1.10"        # <-- REPLACE with this Mac's LAN address.

# Exact target identity for the guarded Remote PC/CIFS one-shot harness.
# Keep the real device-ID hash only in config/tv.env (which is gitignored).
TV_MODEL="GQ55Q60TGUXZG"
TV_FIRMWARE="T-NKLDEUC-2743.0"
TV_ID_SHA256="REPLACE_WITH_SHA256_OF_EXACT_API_DEVICE_ID"

# Optional: seconds before a read-only sdb query is abandoned (§6.3 — stop a
# hang, don't retry). Not applied to the removal command.
SDB_TIMEOUT=30
